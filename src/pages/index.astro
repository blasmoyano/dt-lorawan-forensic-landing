---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Capabilities from '../components/Capabilities.astro';
import Pipeline from '../components/Pipeline.astro';
import VideoDemo from '../components/VideoDemo.astro';
import NodesGallery from '../components/NodesGallery.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Gemelo digital como plataforma forense para análisis de redes LoRaWAN — TFG"
  description="Prototipo de investigación para la adquisición pasiva y preservación de evidencia forense en redes LoRaWAN agroindustriales, con gemelo digital, verificación criptográfica SHA-256 / Ed25519 y cadena de custodia."
>
  <Header />
  <main>
    <Hero />
    <About />
    <Capabilities />
    <Pipeline />
    <VideoDemo />
    <NodesGallery />
  </main>
  <Footer />
</Layout>
