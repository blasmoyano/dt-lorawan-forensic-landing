---
const links = [
  { href: '#que-es', label: 'Qué es' },
  { href: '#capacidades', label: 'Capacidades' },
  { href: '#flujo', label: 'Flujo' },
  { href: '#demo', label: 'Demo' },
  { href: '#nodos', label: 'Nodos' },
];
---

<header class="nav" id="top-nav">
  <div class="container nav-inner">
    <a href="#inicio" class="brand" id="nav-brand" aria-label="Inicio">
      <span class="brand-dot"></span>
      <span class="brand-name">LoRaWAN Forensic DT</span>
      <span class="brand-sep">//</span>
      <span class="brand-tag">TFG Lic. en Seguridad Informática</span>
    </a>
    <nav aria-label="Principal">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} id={`nav-${l.href.slice(1)}`}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const nav = document.getElementById('top-nav');
  const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 20);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    transition: background 0.3s, border-color 0.3s, backdrop-filter 0.3s;
    border-bottom: 1px solid transparent;
  }
  .nav.scrolled {
    background: rgba(5, 8, 15, 0.85);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-color: var(--line);
  }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 68px; gap: 1.5rem; }
  .brand { display: flex; align-items: center; gap: 0.5rem; color: #fff; font-weight: 700; letter-spacing: 0.02em; min-width: 0; }
  .brand-dot {
    width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0;
    background: var(--teal);
    box-shadow: 0 0 0 4px rgba(60, 242, 192, 0.15), 0 0 14px var(--teal);
    animation: pulse 2.4s ease-in-out infinite;
  }
  .brand-name { font-size: 1.05rem; letter-spacing: 0.04em; flex-shrink: 0; }
  .brand-sep { color: var(--cyan); opacity: 0.6; font-size: 0.85rem; flex-shrink: 0; }
  .brand-tag {
    font-size: 0.82rem;
    color: var(--muted);
    font-weight: 400;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  ul { display: flex; gap: 0.3rem; list-style: none; margin: 0; padding: 0; flex-shrink: 0; }
  ul a {
    display: block; padding: 0.45rem 0.85rem; border-radius: 999px;
    color: var(--muted); font-size: 0.9rem; transition: color 0.2s, background 0.2s;
  }
  ul a:hover { color: #fff; background: rgba(94, 231, 255, 0.08); }
  @keyframes pulse { 50% { box-shadow: 0 0 0 7px rgba(60, 242, 192, 0.05), 0 0 20px var(--teal); } }
  
  @media (max-width: 1080px) {
    .brand-tag { max-width: 380px; }
  }
  @media (max-width: 940px) {
    nav { display: none; }
  }
  @media (max-width: 640px) {
    .brand-tag { display: none; }
    .brand-sep { display: none; }
  }
</style>
