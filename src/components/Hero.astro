---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="hero" id="inicio">
  <div class="container hero-grid">
    <div class="hero-copy">
      <div class="badge-academic reveal">
        <span class="badge-icon" aria-hidden="true">🎓</span>
        <span>Trabajo Final de Grado · Licenciatura en Seguridad Informática</span>
      </div>
      <h1 class="reveal" data-delay="1">
        <span class="gradient-text">Gemelo Digital</span>
        <span class="h1-sub">como Plataforma Forense para Redes LoRaWAN</span>
      </h1>
      <p class="lead reveal" data-delay="2">
        Prototipo de investigación y análisis forense no intrusivo y desacoplado para entornos de monitoreo agroindustrial (silobolsas y plantas de acopio). Adquiere tráfico pasivo antes del descarte del Network Server, modela el comportamiento con un gemelo digital y genera evidencia verificable.
      </p>
      
      <div class="academic-meta reveal" data-delay="2">
        <span class="univ"><strong>Universidad Siglo 21</strong></span>
        <span class="sep">·</span>
        <span class="author">Autor: <strong>Blas Moyano</strong></span>
      </div>

      <div class="cta reveal" data-delay="3">
        <a class="btn btn-primary" href="#demo" id="hero-cta-demo">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
          Ver demostraciones
        </a>
        <a class="btn" href="#capacidades" id="hero-cta-capacidades">Explorar arquitectura →</a>
      </div>

      <dl class="stats reveal" data-delay="4">
        <div><dt class="mono">ENTORNO</dt><dd>Agtech / Silobolsas</dd></div>
        <div><dt class="mono">PLAN REGIONAL</dt><dd>AU915-928 (ENACOM)</dd></div>
        <div><dt class="mono">CAPTURA</dt><dd>Pasiva Semtech UDP/1700</dd></div>
        <div><dt class="mono">INTEGRIDAD</dt><dd>SHA-256 & Ed25519</dd></div>
      </dl>
    </div>

    <div class="hero-visual reveal" data-delay="2" aria-hidden="true">
      <div class="ring r1"></div>
      <div class="ring r2"></div>
      <div class="ring r3"></div>
      <div class="tech-radar">
        <img class="hero-node-img" src={`${base}/images/nodos/nodo.jpeg`} alt="Nodo sensor LoRaWAN del banco" />
      </div>
      <div class="scan"></div>

      <div class="hud hud-tl mono">
        <span class="dot"></span> uplink · AU915 SF7BW125<br />
        <span class="dim">SenseCAP M2 ➔ UDP:1700</span>
      </div>
      <div class="hud hud-br mono">
        sha256: 9f2c…e81a ✓<br />
        <span class="amber">▲ indicio: Replay FCnt detectado</span>
      </div>
    </div>
  </div>

  <div class="packets" aria-hidden="true">
    <div class="track mono">
      {Array.from({ length: 2 }).map(() => (
        <span>
          ▸ JoinRequest DevEUI 70B3D5… RSSI -97 SNR 7.5 &nbsp;&nbsp;
          ▸ UnconfirmedDataUp FCnt 0412 917.0 MHz (AU915) &nbsp;&nbsp;
          ▸ Captura pasiva UDP/1700 → PCAP 27.708 B &nbsp;&nbsp;
          ▸ Replay Attack detectado: PHYPayload duplicado &nbsp;&nbsp;
          ▸ Manifiesto SHA-256 ✓ Cadena de custodia registrada &nbsp;&nbsp;
        </span>
      ))}
    </div>
  </div>
</section>

<style>
  .hero { padding: 125px 0 0; min-height: 100vh; display: flex; flex-direction: column; justify-content: center; position: relative; }
  .hero-grid { display: grid; grid-template-columns: 1.15fr 1fr; gap: 3rem; align-items: center; }
  
  .badge-academic {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: rgba(94, 231, 255, 0.08);
    border: 1px solid rgba(94, 231, 255, 0.25);
    color: var(--cyan);
    font-size: 0.8rem;
    font-family: var(--font-mono);
    margin-bottom: 1.2rem;
  }
  .badge-icon { font-size: 0.95rem; }

  h1 { font-size: clamp(3.2rem, 8vw, 6rem); font-weight: 700; margin-bottom: 1.2rem; line-height: 1.08; }
  h1 .gradient-text { display: block; letter-spacing: -0.04em; }
  .h1-sub { display: block; font-size: clamp(1.2rem, 2.3vw, 1.75rem); font-weight: 500; color: #fff; margin-top: 0.6rem; letter-spacing: -0.01em; line-height: 1.25; }
  
  .academic-meta {
    margin: 1.2rem 0;
    font-size: 0.92rem;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .academic-meta strong { color: #fff; }
  .academic-meta .sep { opacity: 0.4; }

  .cta { display: flex; flex-wrap: wrap; gap: 0.9rem; margin: 1.8rem 0 2.2rem; }

  .stats { display: flex; gap: 1.8rem; margin: 0; flex-wrap: wrap; }
  .stats div { border-left: 1px solid var(--line-strong); padding-left: 0.9rem; }
  .stats dt { font-size: 0.68rem; letter-spacing: 0.15em; color: var(--muted); }
  .stats dd { margin: 0.15rem 0 0; font-weight: 600; font-size: 0.92rem; color: #fff; }

  .hero-visual { position: relative; aspect-ratio: 1; max-width: 520px; width: 100%; justify-self: center; }
  .tech-radar {
    position: absolute; inset: 12%; border-radius: 50%; overflow: hidden;
    border: 2px solid var(--line-strong); box-shadow: 0 0 40px rgba(94, 231, 255, 0.2);
    display: flex; align-items: center; justify-content: center;
    background: #060b14;
  }
  .hero-node-img { width: 100%; height: 100%; object-fit: cover; filter: contrast(1.1) brightness(0.95); }
  .ring { position: absolute; border-radius: 50%; border: 1px solid var(--line-strong); inset: 0; }
  .r1 { inset: 4%; border-style: dashed; animation: spin 60s linear infinite; }
  .r2 { inset: 8%; border-color: rgba(60, 242, 192, 0.18); animation: spin 40s linear infinite reverse; }
  .r3 { inset: 20%; background: radial-gradient(circle, rgba(94, 231, 255, 0.18), transparent 70%); border: none; filter: blur(10px); }
  .scan {
    position: absolute; left: 10%; right: 10%; height: 2px; top: 10%;
    background: linear-gradient(90deg, transparent, var(--cyan), transparent);
    box-shadow: 0 0 18px var(--cyan);
    animation: scan 4.5s ease-in-out infinite;
    opacity: 0.8;
  }
  .hud {
    position: absolute; font-size: 0.72rem; line-height: 1.6; padding: 0.7rem 0.9rem;
    background: rgba(8, 14, 24, 0.85); border: 1px solid var(--line-strong); border-radius: 12px;
    backdrop-filter: blur(8px); color: var(--text);
  }
  .hud-tl { top: 8%; left: -4%; animation: float 6s ease-in-out infinite; }
  .hud-br { bottom: 10%; right: -4%; animation: float 6s ease-in-out -3s infinite; }
  .dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--teal); box-shadow: 0 0 8px var(--teal); margin-right: 4px; }
  .dim { color: var(--muted); }
  .amber { color: var(--amber); }

  .packets {
    margin-top: 3.5rem; border-block: 1px solid var(--line); overflow: hidden;
    background: rgba(10, 17, 29, 0.6);
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .track { display: flex; width: max-content; padding: 0.85rem 0; font-size: 0.78rem; color: var(--muted); white-space: nowrap; animation: marquee 42s linear infinite; }

  @keyframes float { 50% { transform: translateY(-10px); } }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes scan { 0%, 100% { top: 12%; } 50% { top: 86%; } }
  @keyframes marquee { to { transform: translateX(-50%); } }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-visual { max-width: 360px; order: -1; }
    .hud-tl { left: 0; } .hud-br { right: 0; }
  }
</style>
