---
import { videos } from '../data/media';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (p?: string) => (p ? `${base}/${p.replace(/^\//, '')}` : undefined);
---

<section class="section" id="demo">
  <div class="container">
    <header class="head">
      <span class="eyebrow reveal">Demostraciones en video</span>
      <h2 class="reveal" data-delay="1">K2SO <span class="gradient-text">en acción</span></h2>
      <p class="lead reveal" data-delay="2">
        Registro de pruebas en laboratorio: captura pasiva de paquetes, detección de anomalías bajo ataque controlado y generación de evidencia verificable.
      </p>
    </header>

    <div class="video-grid">
      {videos.map((vid, idx) => (
        <article class="video-card panel reveal" data-delay={String((idx % 3) + 1)}>
          <div class="player-box">
            <div class="window-bar mono" aria-hidden="true">
              <span class="lights"><i></i><i></i><i></i></span>
              <span class="channel-title">demo_0{idx + 1}.mp4</span>
              <span class="badge-rec">● REC</span>
            </div>

            <div class="screen">
              {vid.id ? (
                <iframe
                  src={`https://www.youtube-nocookie.com/embed/${vid.id}`}
                  title={vid.title}
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                ></iframe>
              ) : vid.src ? (
                <video controls preload="metadata" poster={asset(vid.poster)} title={vid.title}>
                  <source src={asset(vid.src)} type="video/mp4" />
                </video>
              ) : (
                <div class="placeholder">
                  <div class="play-btn" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                  </div>
                  <span class="mono ph-label">VIDEO DEMO #{idx + 1}</span>
                  <small class="ph-desc">Editable en <code>src/data/media.ts</code></small>
                </div>
              )}
            </div>
          </div>

          <div class="video-info">
            <div class="category mono">{vid.category}</div>
            <h3 class="video-title">{vid.title}</h3>
            <p class="video-desc">{vid.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .head { max-width: 780px; margin-bottom: 3.5rem; }
  
  .video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 1.8rem;
  }

  .video-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: transform 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
  }
  .video-card:hover {
    transform: translateY(-6px);
    border-color: var(--line-strong);
    box-shadow: 0 24px 50px -20px rgba(94, 231, 255, 0.3);
  }

  .player-box {
    background: #03060b;
    border-bottom: 1px solid var(--line);
  }

  .window-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 0.9rem;
    font-size: 0.72rem;
    color: var(--muted);
    border-bottom: 1px solid rgba(120, 200, 255, 0.08);
  }
  .lights { display: flex; gap: 6px; }
  .lights i { width: 9px; height: 9px; border-radius: 50%; background: #253248; }
  .lights i:first-child { background: var(--red); }
  .lights i:nth-child(2) { background: var(--amber); }
  .lights i:last-child { background: var(--teal); }
  .badge-rec { color: var(--red); font-size: 0.7rem; animation: blink 1.6s steps(2) infinite; }

  .screen {
    aspect-ratio: 16 / 9;
    position: relative;
    background: #040810;
  }
  .screen iframe, .screen video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.5rem;
    text-align: center;
    padding: 1.5rem;
    background:
      repeating-linear-gradient(0deg, rgba(94, 231, 255, 0.035) 0 2px, transparent 2px 4px),
      radial-gradient(circle at 50% 50%, rgba(94, 231, 255, 0.12), transparent 75%);
  }
  .ph-label { font-size: 0.8rem; letter-spacing: 0.18em; color: var(--cyan); }
  .ph-desc { font-size: 0.78rem; color: var(--muted); }
  .ph-desc code { color: var(--text); background: rgba(255, 255, 255, 0.08); padding: 0.1rem 0.35rem; border-radius: 4px; }

  .play-btn {
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    color: #021018;
    background: linear-gradient(120deg, var(--cyan), var(--teal));
    box-shadow: 0 0 0 6px rgba(94, 231, 255, 0.12);
    margin-bottom: 0.4rem;
  }

  .video-info {
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .category {
    font-size: 0.75rem;
    color: var(--teal);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.4rem;
  }
  .video-title {
    font-size: 1.15rem;
    color: #fff;
    margin: 0 0 0.6rem;
  }
  .video-desc {
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.55;
    margin: 0;
  }

  @keyframes blink { 50% { opacity: 0.2; } }

  @media (max-width: 640px) {
    .video-grid { grid-template-columns: 1fr; }
  }
</style>
