---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Capabilities from '../components/Capabilities.astro';
import Pipeline from '../components/Pipeline.astro';
import VideoDemo from '../components/VideoDemo.astro';
import NodesGallery from '../components/NodesGallery.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="K2SO — Gemelo digital forense para redes LoRaWAN"
  description="K2SO es una prueba de concepto local para adquirir y preservar tráfico LoRaWAN, consultar evidencia, generar indicios mediante un gemelo digital e investigar casos con informes y paquetes verificables."
>
  <Header />
  <main>
    <Hero />
    <About />
    <Capabilities />
    <Pipeline />
    <VideoDemo />
    <NodesGallery />
  </main>
  <Footer />
</Layout>
